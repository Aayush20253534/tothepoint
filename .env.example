# Optional verified custom canonical domain. Leave blank to use Vercel's stable
# production alias. Local and preview builds remain noindex.
NEXT_PUBLIC_SITE_URL=
# Optional production kill switch: SEO_INDEXING_DISABLED=true
# Optional opt-out from the Vercel alias: SEO_ALLOW_VERCEL_DOMAIN=false

# Public webmaster verification tokens (never invent these values)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Part 10 - required on the hosting server for contact email.
# Create these in Vercel environment variables. Do not commit real secrets.
CONTACT_TO_EMAIL=tothepointastrology@gmail.com
CONTACT_FROM_EMAIL=SmartJyotishi <contact@your-verified-domain.example>
RESEND_API_KEY=
